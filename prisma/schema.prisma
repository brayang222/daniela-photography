// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin
}

// Canonical Auth.js/NextAuth Prisma-adapter schema — field names and types
// below must match what @auth/prisma-adapter expects.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(user)
  /// Solo se usa para los accesos de /admin — nunca hay registro público,
  /// así que no hace falta un flujo de "olvidé mi contraseña".
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Una foto dentro de la galería de un proyecto. `cover` en Project apunta
/// al `src` de una de estas — no es una relación separada porque el admin
/// solo necesita elegir "cuál de las que ya subí es la principal", no
/// gestionar dos listas distintas.
model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  category    String
  year        String
  /// Línea corta opcional bajo la categoría (ej. "Naturaleza · Frescura ·
  /// Bienestar"). No todos los proyectos la tienen.
  concept     String?
  description String
  role        String[]
  tools       String[]
  coverSrc    String
  gallery     Json
  /// Orden de aparición en el carrusel de la home.
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
