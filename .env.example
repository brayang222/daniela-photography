# Copia esto a .env y llena los valores reales. Nunca commitees .env.

# Neon Postgres — conexión pooled, la usa la app en tiempo de ejecución.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# Neon Postgres — conexión directa (sin pool), la usa Prisma Migrate.
# Mismo host que arriba, sin el segmento "-pooler".
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require"

# --- Acceso a /admin (correo + contraseña, sin registro público) ---

# URL pública del sitio — NextAuth la usa para construir las URLs de
# callback/redirect correctas.
AUTH_URL="http://localhost:3000"

# Genera con: openssl rand -base64 32
AUTH_SECRET=

# Los dos únicos accesos al panel. Genera cada hash con:
# npx tsx scripts/hash-password.ts "la-contraseña-real"
# Cada $ debe quedar escapado como \$ — Next.js expande cualquier $NOMBRE
# sin escapar en archivos .env como si fuera una variable, y eso corrompe
# un hash bcrypt. El script ya lo imprime escapado, listo para pegar.
ADMIN1_EMAIL=
ADMIN1_PASSWORD_HASH=

ADMIN2_EMAIL=
ADMIN2_PASSWORD_HASH=
